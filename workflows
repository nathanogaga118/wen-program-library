name: Solana Security Audit

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Run Solanaizer
        uses: solanaizer/solanaizer-action@v1
        with:
          target: ./path/to/your/solana/program  # Set your contract directory
          output: report.json
          
      - name: Upload Audit Report
        uses: actions/upload-artifact@v3
        with:
          name: solanaizer-report
          path: report.json
